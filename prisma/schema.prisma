datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth standard models for Neon DB / PostgreSQL
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?       @map("email_verified")
  image         String?
  password      String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  preferences   UserPreference?
  customPosts   CustomPost[]
  aiPlaylists   AiPlaylist[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Pulse Dashboard Specific Models
model UserPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  favoriteCategories     String[] @default(["technology", "finance", "science"])
  favoriteTypes          String[] @default(["news", "recommendation", "social", "music"])
  theme                  String   @default("dark")
  language               String   @default("en")
  autoRefreshRealtime    Boolean  @default(true)
  refreshIntervalSeconds Int      @default(30)
  compactMode            Boolean  @default(false)
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model CustomPost {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  title     String
  summary   String   @db.Text
  category  String
  type      String   @default("news")
  imageUrl  String?  @map("image_url")
  url       String?
  source    String   @default("User Created")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("custom_posts")
}

model AiPlaylist {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  title       String
  description String   @db.Text
  prompt      String   @db.Text
  sentiment   Json
  tracks      Json
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_playlists")
}
